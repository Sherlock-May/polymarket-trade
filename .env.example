# 修改后需要重启。模式不能热切换；默认使用生产行情模拟，不会下真实订单。
DRY_RUN=true
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACK=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
# 赎回需要合法可用的 Relayer 授权；不自动创建钱包或发送授权交易。
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
AUTO_REDEEM=false
# 可选：只读查询链上回执及 gas；支持普通 HTTPS Polygon JSON-RPC。
POLYGON_RPC_URL=
DATABASE_PATH=data/paper.db
LOG_LEVEL=INFO
LOG_TIMEZONE=Asia/Shanghai
